# Happier Relay Server - Production Environment Example
#
# Copy this file to .env.production and customize as needed.
# Usage: ./deploy-relay.sh --env-file .env.production
#
# Most settings are optional - relay-server has sensible defaults for self-hosting.

# =============================================================================
# REQUIRED (if you want to override defaults)
# =============================================================================

# Master secret for auth token signing and server-side encryption.
# If unset, relay-server auto-generates and persists one in /data.
# Recommended: set this for reproducible deployments.
HANDY_MASTER_SECRET=change-me-to-a-secure-random-string-at-least-32-characters

# =============================================================================
# NETWORK
# =============================================================================

# Server port (default: 3005, already set by deploy script)
# PORT=3005

# Public URL for share links and OAuth callbacks.
# Set this if your server is accessible via a domain.
# PUBLIC_URL=https://your-domain.com

# =============================================================================
# DATABASE
# =============================================================================

# Database provider (default: sqlite)
# Options: sqlite, pglite, postgres
HAPPIER_DB_PROVIDER=sqlite

# For postgres, set DATABASE_URL:
# DATABASE_URL=postgresql://user:pass@host:5432/happier?sslmode=require

# =============================================================================
# FILES STORAGE
# =============================================================================

# Files backend (default: local for relay-server)
# Options: local, s3
HAPPIER_FILES_BACKEND=local

# =============================================================================
# UI SERVING
# =============================================================================

# Relay-server embeds web UI by default.
# To disable UI serving (API-only mode):
# HAPPIER_SERVER_UI_DIR=

# To serve UI under a prefix instead of root:
# HAPPIER_SERVER_UI_PREFIX=/ui

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# GitHub OAuth (for login/signup with GitHub)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URL=https://your-domain.com/v1/oauth/github/callback

# =============================================================================
# SECURITY / AUTH POLICY
# =============================================================================

# Disable anonymous signup (require OAuth)
# AUTH_ANONYMOUS_SIGNUP_ENABLED=false

# Restrict signup to specific providers
# AUTH_SIGNUP_PROVIDERS=github

# GitHub org/user allowlist
# AUTH_GITHUB_ALLOWED_ORGS=your-org
# AUTH_GITHUB_ALLOWED_USERS=user1,user2